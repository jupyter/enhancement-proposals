{"version":3,"kind":"Article","sha256":"45e1052d5bbd7b9348f2075170dd0dcba2854c3ffe14d3049029c7bc028f4dc6","slug":"jupyter-enterprise-gateway-incorporation","location":"/25-jupyter-enterprise-gateway-incorporation/jupyter-enterprise-gateway-incorporation.md","dependencies":[],"frontmatter":{"title":"Jupyter Enterprise Gateway Incorporation","date":"2018-09-16","content_includes_title":false,"github":"https://github.com/jupyter/enhancement-proposals","numbering":{"title":{"offset":1}},"source_url":"https://github.com/jupyter/enhancement-proposals/blob/main/25-jupyter-enterprise-gateway-incorporation/jupyter-enterprise-gateway-incorporation.md","edit_url":"https://github.com/jupyter/enhancement-proposals/edit/main/25-jupyter-enterprise-gateway-incorporation/jupyter-enterprise-gateway-incorporation.md","thumbnail":"/enhancement-proposals/build/jupyter_enterprise_g-800bc7fd5ebd2aeb5284fb7791097fb4.gif","exports":[{"format":"md","filename":"jupyter-enterprise-gateway-incorporation.md","url":"/enhancement-proposals/build/jupyter-enterprise-g-b432c5c1324977448e2f9451d00f7992.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"Problem","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"ALt9pV0xxl"}],"identifier":"problem","label":"Problem","html_id":"problem","implicit":true,"key":"VqE2UCS2HR"},{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Founded in academia, the Jupyter projects provide a rich and highly popular set of applications for\ninteracting with and iterating on large and complex applications.  It has been truly ground-breaking.\nHowever, when we first attempted to build a Notebook service that could enable a large number of data\nscientists to run frequent and large workloads against a large Apache Spark cluster, we identified\nseveral requirements that were not currently available in the Jupyter open source ecosystem. We tried\nto use the Jupyter Kernel Gateway project, but we quickly realized that the JKG server became the\nbottleneck because the co-located Spark driver application for these kinds of workloads (in this case,\nthe kernel process running on behalf of notebook cells) were extremely resource intensive. In organizations\nwith multiple data scientists, you can quickly saturate the compute resources of the Kernel Gateway server.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"AwgTk4TnNz"}],"key":"xkVq7uf9mU"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Jupyter Enterprise Gateway enables Jupyter Notebook to launch and manage remote kernels in a distributed cluster,\nincluding Apache Spark managed by YARN, IBM Spectrum Conductor or Kubernetes. New platforms can be added via an\nextensibility layer that would handle specific capabilities of the underlying cluster manager.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"A2ucpFzHD8"}],"key":"KubjBO0v4m"},{"type":"heading","depth":2,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Proposed Enhancement","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"CRIdybXK2M"}],"identifier":"proposed-enhancement","label":"Proposed Enhancement","html_id":"proposed-enhancement","implicit":true,"key":"i4SiSf9KZc"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"The incubating ","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"aiT9yYiTvd"},{"type":"link","url":"https://github.com/jupyter-incubator/enterprise_gateway","position":{"start":{"line":28,"column":1},"end":{"line":28,"