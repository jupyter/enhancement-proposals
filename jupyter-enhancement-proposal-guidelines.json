olumn":1},"end":{"line":50,"column":1}},"key":"hF41nCG0nc"}],"key":"wf25o4Zj06"}],"key":"hBDHXEShFd"},{"type":"listItem","spread":true,"position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Non-trivial features or improvements that span multiple projects.","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"QwVrvKyp1n"}],"key":"du95GiUreX"}],"key":"ZhDLZt0H1V"},{"type":"listItem","spread":true,"position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Any proposed changes to published APIs or core specifications (e.g., nbformat)","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"N8fnPvdG55"}],"key":"EBC1wQBf5h"}],"key":"wUX4CtjGdy"},{"type":"listItem","spread":true,"position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Changes to the JEP process itself.","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"P5s1yzyDm9"}],"key":"fDsCsQ9vn6"}],"key":"gfl4Q2KOwQ"},{"type":"listItem","spread":true,"position":{"start":{"line":56,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Launching a major project in one of the Jupyter GitHub organizations.","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"HSvtZhz2ue"}],"key":"TGCmkSAqGm"}],"key":"wVHQe7EVKU"}],"key":"oaEhWZltG8"}],"key":"yiqAsV40aJ"}],"key":"PEWqbvzV71"},{"type":"heading","depth":2,"position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"text","value":"JEP Submission Workflow","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"grTbZ12PSZ"}],"identifier":"jep-submission-workflow","label":"JEP Submission Workflow","html_id":"jep-s