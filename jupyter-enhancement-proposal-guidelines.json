,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Goals of the JEP process","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"pBafUVZaOE"}],"identifier":"goals-of-the-jep-process","label":"Goals of the JEP process","html_id":"goals-of-the-jep-process","implicit":true,"key":"hUQqRcTSH6"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Project Jupyter uses the Jupyter Enhancement Proposal process (JEP)\nto address distributed collaboration and experimentation.\nThe primary guiding principle of the JEP process is to\nencourage collaboration and discussion as early as possible in the lifecycle\nof a major proposed change in Jupyter, with the goal of preventing costly rework,\ncompeting ideas, and unnecessary forking or fragmentation of ideas.","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"Ss6Tnwut7l"}],"key":"FjLQBqCfC1"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Several sub-goals exist for this process:","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"z5py8951x1"}],"key":"qjrzEv6grQ"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":17,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Maximize success of large proposals","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"HUzniamqTe"}],"key":"cXYjj7itVH"},{"type":"text","value":" that get stalled in the wrong venue (e.g. a single PR comment thread)","position":{"start":{"line":17,"