ildren":[{"type":"text","value":"Provide a ","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"tqQFXAKDWL"},{"type":"strong","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"consolidated “stream” of all proposals across the entire Jupyter community","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"AVK2iHq5Qd"}],"key":"tz7lz3FO0x"},{"type":"text","value":"\nthat contributors of all levels can monitor and selectively engage in.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"IdYyDtxkJa"}],"key":"VIQsDrEr7e"}],"key":"Hjku3ClKqN"}],"key":"Jf36O57pRj"},{"type":"heading","depth":2,"position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Tenets of the JEP process","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"sA5dDf9cgW"}],"identifier":"tenets-of-the-jep-process","label":"Tenets of the JEP process","html_id":"tenets-of-the-jep-process","implicit":true,"key":"b9IastgDRs"},{"type":"paragraph","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"The JEP process operates under the following tenets:","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"b4Kr1CPgPs"}],"key":"rKPWAt2cDF"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":31,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":31,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"strong","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"The JEP process is intended for changes of non-trivial scope.","position":{"start":{"line":31,"column":1},