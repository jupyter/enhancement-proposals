agraph","position":{"start":{"line":29,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"This greatly improves the usability of remote kernels whose startup includes scheduling. By making this change,\nrestarts for remote kernels will be nearly as fast as those of local kernels. It also matches what we\nbelieve to be the mental model of users when they click “restart”.","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"xDUfKbIqdz"}],"key":"Wz1sozGvaE"},{"type":"heading","depth":2,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Guide-level explanation","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"Js5dMXoqej"}],"identifier":"guide-level-explanation","label":"Guide-level explanation","html_id":"guide-level-explanation","implicit":true,"key":"sxN08qRezS"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"The ","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"OjpUzoyIHw"},{"type":"link","url":"https://jupyter-client.readthedocs.io/en/latest/messaging.html#kernel-shutdown","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"protocol","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"WJlSU5hZrs"}],"urlSource":"https://jupyter-client.readthedocs.io/en/latest/messaging.html#kernel-shutdown","key":"GnzhB48tIX"},{"type":"text","value":" would describe\nrestart as optimally preserving as many resources outside the kernel as possible (e.g. restarting only the kernel process and its subprocess ","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"ovOR0pYBwB"},{"type":"emphasis","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"not","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"CYZrTXeOoX"}],"key":"Bm4Fj5dF5u"},{"type":"text","value":" any parent process).","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"fGcg1sbike"}],"key":"BP4ij0niEo"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"When the kernel is a toplevel process (e.g. local kernels), there is no change.","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"aM7n3I4hua"}],"key":"P20PJsoHfj"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"When the kernel is not a toplevel process (e.g. when used in Enterprise Gateway), restart often means only the kernel restarts. To restart the whole progress group, the stop and start messages could be used. It’s up to UIs\nfor how to display this difference (if any).","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"sgMjlfRdRL"}],"key":"OIxfFUgA9t"},{"type":"heading","depth":2,"position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Reference-level explanation","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"stt9ufJ757"}],"identifier":"reference-level-explanation","label":"Reference-level explanation","html_id":"reference-level-explanation","implicit":true,"key":"t75N314XE8"},{"type":"paragraph","position":{"start":{"line":45,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"The ","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"Hn7OkvQanu"},{"type":"inlineCode","value":"jupyter-client","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"yrrar98rIC"},{"type":"text","value":" messaging page would be updated to indicate this nuance. Any implementations that\ntreat restart 