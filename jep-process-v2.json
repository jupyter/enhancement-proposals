{"version":3,"kind":"Article","sha256":"9ef90bfe580255acc3e44973115ec59457ff529f41e63822144bfafc2a9761d4","slug":"jep-process-v2","location":"/104-jep-process-v2/jep-process-v2.md","dependencies":[],"frontmatter":{"title":"Jupyter Enhancement Proposal","authors":[{"id":"Jason Grout ([jason@jasongrout.org](mailto:jason@jasongrout.org)), Safia Abdalla ([safia@safia.rocks](mailto:safia@safia.rocks)), John Lam ([jflam@microsoft.com](mailto:jflam@microsoft.com)), Kevin M. McCormick ([mckev@amazon.com](mailto:mckev@amazon.com)), Pierre Brunelle ([brunep@amazon.com](mailto:brunep@amazon.com)), Paul Ivanov ([pi@berkeley.edu](mailto:pi@berkeley.edu))\n","name":"Jason Grout ([jason@jasongrout.org](mailto:jason@jasongrout.org)), Safia Abdalla ([safia@safia.rocks](mailto:safia@safia.rocks)), John Lam ([jflam@microsoft.com](mailto:jflam@microsoft.com)), Kevin M. McCormick ([mckev@amazon.com](mailto:mckev@amazon.com)), Pierre Brunelle ([brunep@amazon.com](mailto:brunep@amazon.com)), Paul Ivanov ([pi@berkeley.edu](mailto:pi@berkeley.edu))\n"}],"date":"2023-10-30","content_includes_title":false,"github":"https://github.com/jupyter/enhancement-proposals","numbering":{"title":{"offset":1}},"source_url":"https://github.com/jupyter/enhancement-proposals/blob/main/104-jep-process-v2/jep-process-v2.md","edit_url":"https://github.com/jupyter/enhancement-proposals/edit/main/104-jep-process-v2/jep-process-v2.md","thumbnail":"/enhancement-proposals/build/jep_status.drawio-16c268940f31a2590b25b1d87948fa4f.svg","exports":[{"format":"md","filename":"jep-process-v2.md","url":"/enhancement-proposals/build/jep-process-v2-eda0337f2dc66f4e17a2c7e7d3ee2213.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Background","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"O5B7C66E8S"}],"identifier":"background","label":"Background","html_id":"background","implicit":true,"key":"G9Wa3eeKJd"},{"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Project Jupyter has an existing repository and process for “Jupyter Enhancement Proposals” or JEP for short. The repository is here:","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"GkKM8mzd38"}],"key":"ocfUFltGkh"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"link","url":"https://github.com/jupyter/enhancement-proposals","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"https://​github​.com​/jupyter​/enhancement​-proposals","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"msPX6DAJBf"}],"urlSource":"https://github.com/jupyter/enhancement-proposals","error":true,"key":"qh4RvscHsD"}],"key":"NwAk4Isc1V"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"This format was originally used by ","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"mFV4Y1AYiG"},{"type":"link","url":"https://github.com/ipython/ipython/wiki/IPEPs:-IPython-Enhancement-Proposals","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"IPython (IPEP)","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"veEAUszBT1"}],"urlSource":"https://github.com/ipython/ipython/wiki/IPEPs:-IPython-Enhancement-Proposals","error":true,"key":"C9gVuLpbnw"},{"type":"text","value":" and continues to be used by the ","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"OxThO1xuTH"},{"type":"link","url":"https://www.python.org/dev/peps/","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Python Core language (PEP)","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"IWBOpMPy2c"}],"urlSource":"https://www.python.org/dev/peps/","key":"qaNlaEimES"},{"type":"text","value":". As currently envisioned, JEPs are written documents, in the form of a Pull Request to this repo, which describes significant proposed units of work on the projects. The README of the repo summarizes this as:","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"tcrpXw1GBV"}],"key":"IyRq9ABv5v"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"“Jupyter Enhancement Proposals will be used when presenting changes or additions that affect multiple components of the Jupyter ecosystem OR changes to a single key component.”","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"zsmhpubvMv"}],"key":"h3myV58KUS"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Since the JEP process was created, Jupyter has grown in the number of users, diversity of usage cases, number of contributors, and number of repos/org. For a variety of reasons, the JEP process has not scaled with this growth. The current situation is characterized by:","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"VDfP1pmSfu"}],"key":"vfQYKPm390"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":30,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Given the scope of development, it is difficult to follow all of the activity;","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"nCgLlqebXg"}],"key":"gvk9VGVZgQ"}],"key":"ruon2sLqct"},{"type":"listItem","spread":true,"position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"As a result, most decisions are made in a distributed manner by local teams of contributors working on particular repos and orgs (hub, lab, ipython, jupyter-widgets, etc.); as a consequence:","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"aO6dB31uqn"}],"key":"ZIOOd8c4IW"}],"key":"NEgoOwmivj"},{"type":"listItem","spread":true,"position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Distributed decisions that affect the project as a whole are made, without all relevant parties being able to participate and contribute.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"RNCaScvRIy"}],"key":"zVpshJkUIY"}],"key":"CnIHfyCZCE"},{"type":"listItem","spread":true,"position":{"start":{"line":33,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"This is leading to fragmentation and slow progress in project wide concerns, such as the core protocols and standards of Jupyter.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"jdDzise4C3"}],"key":"Bb7ojLHIrR"}],"key":"OK5rR6egVW"}],"key":"bJRdnPHPaM"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"As a result, there is a need to revitalize and reorganize an efficient and robust centralized proposal and decision making process for major work units across the project.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"Gh4KADPZtc"}],"key":"VfRfjoUR9j"},{"type":"heading","depth":2,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"Goals and Tenets","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"dp4U9pRaNu"}],"identifier":"goals-and-tenets","label":"Goals and Tenets","html_id":"goals-and-tenets","implicit":true,"key":"JA3ZA9ODtD"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Project Jupyter has adopted the Jupyter Enhancement Proposal process (JEP) to address distributed collaboration and experimentation as the project scales in the dimensions of contributors, components, and lines of code.  At a high level, the primary guiding principle of the JEP process is to encourage collaboration and discussion as early as possible in the lifecycle of a major proposed change in Jupyter, with the goal of preventing costly rework, competing ideas, and unnecessary forking or fragmentation of ideas.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"D9vUY8x5mm"}],"key":"mV5KjGQ8eh"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Several sub-goals exist for this process:","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"lp3JHxiJmM"}],"key":"VgxHUKWhIo"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":43,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Maximize success of large proposals","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"Bo6w0KCicW"}],"key":"qkNAt9ni7Y"},{"type":"text","value":" that get stalled in the wrong venue (e.g. a single PR comment thread)","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"k3tbGpE3kg"}],"key":"PZuxNLIfom"}],"key":"ZUmIMyJUWj"},{"type":"listItem","spread":true,"position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Provide a ","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"wo0hHT0Wnz"},{"type":"strong","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"better alternative to “piecemeal” development","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"zFoEtb5EuH"}],"key":"JamqZxqFAb"},{"type":"text","value":" where multiple PRs to build an end-to-end set of functionality are split across multiple GitHub project without broad consensus, context, or guidance.","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"xem5icHOWV"}],"key":"HAZNEnvyo8"}],"key":"YGWnrCPPt5"},{"type":"listItem","spread":true,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Provide a ","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"Uo9cGbVT0T"},{"type":"strong","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"clear, time-limited, and authoritative process for work proposals","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"aLM3hcv6qu"}],"key":"BY5wH6FNHx"},{"type":"text","value":", to facilitate funding conversations.  (e.g. provide a concrete artifact to reference in a grant proposal, roadmap item, etc.)","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"hFhgWUSW25"}],"key":"zApnAluT4N"}],"key":"E2uYAUpheR"},{"type":"listItem","spread":true,"position":{"start":{"line":46,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Provide a ","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"wZEbsNkq6R"},{"type":"strong","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"consolidated “stream” of all proposals across the entire Jupyter community","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"DkIjfCCJBi"}],"key":"zTEXO5rBOP"},{"type":"text","value":" that contributors of all levels can monitor and selectively engage in.","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"qNAz4t3RJX"}],"key":"sqPYxS4WPz"}],"key":"FG1uZ2QRpe"}],"key":"WUJM9REfpf"},{"type":"paragraph","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"With that in mind, the JEP process operates under the following tenets:","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"xerwb0X4TU"}],"key":"mPcrNjd5ZP"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":50,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":50,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"strong","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"The JEP process is intended for proposed changes of non-trivial scope.","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"gPuqAikCFk"}],"key":"wfrnW0jAFy"},{"type":"text","value":"  “Non-trivial” is addressed below in the “JEP / Not-a-JEP Rubric” of this document.  If proposals that go through the JEP process do not receive the benefits listed above, the JEP process should be amended to better scope what applied.","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"YZdNx1AOUW"}],"key":"meXUH6gzu6"}],"key":"LfzRPrTQGq"},{"type":"listItem","spread":true,"position":{"start":{"line":52,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"strong","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"The JEP process naturally complements the PR process, but does not replace it.","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"sFLHtKuAub"}],"key":"h0U6KD9KA8"},{"type":"text","value":"  A thoroughly-reviewed and approved JEP is a valuable reference during a PR to reduce friction, reduce time-consuming context sharing, and encapsulate decisions and other discussions.  Moving a premature PR into a JEP should be a lightweight process that doesn’t cause friction for the contributor.","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"uENjLgTdq0"}],"key":"KxdbHxkMxF"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":54,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":54,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"GitHub issue and PR templates, for example, across the entire Jupyter project, should have references to the JEP process as a possible outcome of a given PR.","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"Q4sR8uGnwJ"}],"key":"rSr3gGiJXH"}],"key":"kcMrJBO54R"}],"key":"CVnJQf4t5P"}],"key":"I6Z69Q3mHE"},{"type":"listItem","spread":true,"position":{"start":{"line":56,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"strong","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"text","value":"There is one JEP repository, all Jupyter-governed projects must use it.","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"a9iDsxMMtC"}],"key":"zQW9Wyue32"},{"type":"text","value":"  To facilitate the easiest possible adoption and high visibility of ideas, a single JEP repository will be used.  Even if a JEP only applies to a single organization.","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"nuHZaOvyM6"}],"key":"hoIWf1IDub"}],"key":"Pe3MyxPuGA"},{"type":"listItem","spread":true,"position":{"start":{"line":58,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"text","value":"The JEP process ","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"hyzPlgJw8Y"},{"type":"strong","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"text","value":"has multiple valid use cases","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"ejmBaXJAAP"}],"key":"ECtf4SziM0"},{"type":"text","value":".  Each use case might have a slightly different expected workflow or base JEP template.  Some expected use cases include:","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"BrtIDvdB98"}],"key":"xI0jr1D6J3"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":60,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Non-trivial feature proposals within a single component that would benefit from process.  (e.g., a non-trivial change to JupyterLab that would benefit from formal process within the JupyterLab project)","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"Zaj3qhhEnA"}],"key":"UqArxZayMK"}],"key":"TxWy9aw0hv"},{"type":"listItem","spread":true,"position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Non-trivial features or improvements that span multiple projects.","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"ncknh622kd"}],"key":"Ko60NhsD4A"}],"key":"mNM4DIrB0J"},{"type":"listItem","spread":true,"position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Any proposed changes to published APIs or core specifications (e.g., nbformat)","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"Xk3I9BzG7U"}],"key":"XvArhvEalZ"}],"key":"Vmmx9hYfzr"},{"type":"listItem","spread":true,"position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Changes to the JEP process itself.","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"qTAyMJ0xoh"}],"key":"yyLoQLouX8"}],"key":"AFhJ57DLqG"},{"type":"listItem","spread":true,"position":{"start":{"line":64,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Creating a new official GitHub organization.","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"m9I8itRvZS"}],"key":"Svz5I8zUkJ"}],"key":"plOUepk2ut"}],"key":"wvss6rvhtS"}],"key":"irZsJ159sT"}],"key":"aKnvghDwef"},{"type":"heading","depth":2,"position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"text","value":"JEP Submission Workflow","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"Dep7KFMaMF"}],"identifier":"jep-submission-workflow","label":"JEP Submission Workflow","html_id":"jep-submission-workflow","implicit":true,"key":"ZLu0TcIHZv"},{"type":"heading","depth":3,"position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"children":[{"type":"text","value":"Phase 1: Pre-proposal","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"ubrb9dYWy2"}],"identifier":"phase-1-pre-proposal","label":"Phase 1: Pre-proposal","html_id":"phase-1-pre-proposal","implicit":true,"key":"RYKabC0gPR"},{"type":"paragraph","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"This is the least formal stage of any jupyter enhancement proposals. During this phase, discussions on the mailing list, in-person, on github issues are all fine to gauge community interest, feasibility, consequences, and to scope out technical impact and implementation details.","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"tmxZwcbpod"}],"key":"UYvIAHRLtA"},{"type":"paragraph","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"In order to transition out of the pre-proposal stage, the following checklist must be complete:","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"uhUyaoA6cF"}],"key":"I7BuHLa9KE"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":75,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"A github issue on the Jupyter Enhancement Proposals repo is created that","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"kDqSQjBQFN"}],"key":"P3CkYYq7aW"}],"key":"h7MFE90qy2"},{"type":"listItem","spread":true,"position":{"start":{"line":76,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":76,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":76,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Briefly outlines the proposal","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"jwCta12SXn"}],"key":"wEYi1qm4Un"}],"key":"jQRqJWMlOs"}],"key":"ZVj6pF1qnE"}],"key":"fgfLDlS4ur"},{"type":"listItem","spread":true,"position":{"start":{"line":78,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"Suggests reviewers (optional) in addition to the SSC members.","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"ycyqfrxMqO"}],"key":"hx2f9XNgZK"},{"type":"list","ordered":true,"start":3,"spread":false,"position":{"start":{"line":80,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":80,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"Why it should be a JEP","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"GUFaWx9ySX"}],"key":"bu3umuxg2C"}],"key":"VU6YQ03zjC"},{"type":"listItem","spread":true,"position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"See the “JEP / Not-a-JEP Rubric” below.","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"I