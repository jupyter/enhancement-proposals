art":{"line":131,"column":1},"end":{"line":131,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"{ \"op\": \"removerange\",  \"key\": <string>, \"length\": <n>}","position":{"start":{"line":131,"column":1},"end":{"line":131,"column":1}},"key":"A3tvsgBI4w"},{"type":"text","value":": delete the values A[key:key+length]","position":{"start":{"line":131,"column":1},"end":{"line":131,"column":1}},"key":"JsiL3Ue4zr"}],"key":"DTdDeRm2wt"}],"key":"BuHmHg141g"},{"type":"listItem","spread":true,"position":{"start":{"line":132,"column":1},"end":{"line":132,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"{ \"op\": \"addrange\",     \"key\": <string>, \"valuelist\": <values> }","position":{"start":{"line":132,"column":1},"end":{"line":132,"column":1}},"key":"PMFdDh5UwN"},{"type":"text","value":": insert new items from valuelist before A[key], at end if key=len(A)","position":{"start":{"line":132,"column":1},"end":{"line":132,"column":1}},"key":"gcriINco7u"}],"key":"KoXpg9qP2B"}],"key":"VeXlWjC7B3"},{"type":"listItem","spread":true,"position":{"start":{"line":133,"column":1},"end":{"line":135,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"{ \"op\": \"patch\",   \"key\": <string>, \"diff\": <diffobject> }","position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"key":"Qyttlx8rf9"},{"type":"text","value":": patch existing value at key with another diffobject","position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"key":"djvbeAT03D"}],"key":"pz9LGqFTJb"}],"key":"jkO0jDtyWe"}],"key":"XvbBezL9qw"},{"type":"heading","depth":3,"position":{"start":{"line":136,"column":1},"end":{"line":136,"column":1}},"children":[{"type":"text","value":"Relation to JSONPatch","position":{"start":{"line":136,"column":1},"end":{"line":136,"column":1}},"key":"HBtHC2wsCP"}],"identifier":"relation-to-jsonpatch","label":"Relation to JSONPatch","html_id":"relation-to-jsonpatch","implicit":true,"key":"PApxGf0yLx"},{"type":"paragraph","position":{"start":{"line":138,"column":1},"end":{"line":139,"column":1}},"children":[{"type":"text","value":"The above described diff representation has similarities with the\nJSONPatch standard but is different in some significant ways:","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"key":"aF2i1k6HG4"}],"key":"PIwCRH6D8B"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":141,"column":1},"end":{"line":158,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":141,"column":1},"end":{"line":144,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":141,"column":1},"end":{"line":143,"column":1}},"children":[{"type":"text","value":"JSONPatch contains operations “move”, “copy”, “test” not used by\nnbdime, and nbdime contains operations “addrange”, “removerange”, and\n“patch” not in JSONPatch.","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"key":"RaDd6zKikM"}],"key":"O8dbphKecY"}],"key":"V5O0aN5MBm"},{"type":"listItem","spread":true,"position":{"start":{"line":145,"column":1},"end":{"line":151,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":145,"column":1},"end":{"line":150,"column":1}},"children":[{"type":"text","value":"Instead of providing a recursive “patch” op, JSONPatch uses a deep\nJSON pointer based “path” item in each operation instead of the “key”\nitem nbdime uses. This way JSONPatch can represent the diff object as\na single list instead of the ‘tree’ of lists that nbdime uses. The\nadvantage of the recursive approach is that e.g. all changes to a cell\nare grouped and do not need to be collected.","position":{"start":{"line":145,"column":1},"end":{"line":145,"column":1}},"key":"akV4rDt5wa"}],"key":"Vok7CXBAN6"}],"key":"U1um8zsdWX"},{"type":"listItem","spread":true,"position":{"start":{"line":152,"column":1},"end":{"line":158,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":152,"column":1},"end":{"line":157,"column":1}},"children":[{"type":"text","value":"JSONPatch uses indices that relate to the intermediate (partially\npatched) object, meaning transformation number n cannot be interpreted\nwithout going through the transformations up to n-1.  In nbdime the\nindices relate to the base object, which means ‘delete cell 7’ means\ndeleting cell 7 of the base notebook independently of the previous\ntransformations in the diff.","position":{"start":{"line":152,"column":1},"end":{"line":152,"column":1}},"key":"aHhfu3fPiP"}],"key":"ljZTgSl865"}],"key":"E9EdVNCi7C"}],"key":"SxCCl9WQCV"},{"type":"paragraph","position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"children":[{"type":"text","value":"A conversion function can fairly easily be implemented.","position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"key":"tWaQugKZZL"}],"key":"Ib1PDB8Uuv"},{"type":"heading","depth":2,"position":{"start":{"line":162,"column":1},"end":{"line":162,"column":1}},"children":[{"type":"text","value":"High level diff algorithm approach","position":{"start":{"line":162,"column":1},"end":{"line":162,"column":1}},"key":"Fc6rKmI9Oq"}],"identifier":"high-level-diff-algorithm-approach","label":"High level diff algorithm approach","html_id":"high-level-diff-algorithm-approach","implicit":true,"key":"CsklcGHng2"},{"type":"paragraph","position":{"start":{"line":164,"column":1},"end":{"line":164,"column":1}},"children":[{"type":"text","value":"The package will contain both generic and notebook-specific variants of diff algorithms.","position":{"start":{"line":164,"column":1},"end":{"line":164,"column":1}},"key":"Zc9wWQBG4w"}],"key":"lwDZpNGX9B"},{"type":"paragraph","position":{"start":{"line":166,"column":1},"end":{"line":166,"column":1}},"children":[{"type":"text","value":"The generic diff algorithms will handle most json-compatible objects:","position":{"start":{"line":166,"column":1},"end":{"line":166,"column":1}},"key":"R4bMRpOzHq"}],"key":"g3yTFVxIgH"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":168,"column":1},"end":{"line":173,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":168,"column":1},"end":{"line":169,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":168,"column":1},"end":{"line":168,"column":1}},"children":[{"type":"text","value":"Arbitrary nested structures of dicts and lists are allowed","position":{"start":{"line":168,"column":1},"end":{"line":168,"column":1}},"key":"rAxh05MFWp"}],"key":"ilaZxpxpj6"}],"key":"vQt3Yi7bjC"},{"type":"listItem","spread":true,"position":{"start":{"line":170,"column":1},"end":{"line":171,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":170,"column":1},"end":{"line":170,"column":1}},"children":[{"type":"text","value":"Leaf values can be any strings and numbers","position":{"start":{"line":170,"column":1},"end":{"line":170,"column":1}},"key":"mUZR1TF4tS"}],"key":"RQxZnWmpmz"}],"key":"JJPbDX4qlR"},{"type":"listItem","spread":true,"position":{"start":{"line":172,"column":1},"end":{"line":173,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":172,"column":1},"end":{"line":172,"column":1}},"children":[{"type":"text","value":"Dict keys must always be strings","position":{"start":{"line":172,"column":1},"end":{"line":172,"column":1}},"key":"Q3jOVr6KTD"}],"key":"bOfYcTjCsD"}],"key":"S1oUfiJTMd"}],"key":"xcRb8sjE3F"},{"type":"paragraph","position":{"start":{"line":174,"column":1},"end":{"line":178,"column":1}},"children":[{"type":"text","value":"The generic variants will by extension produce correct diffs for\nnotebooks, but the notebook-specific variants aim to produce more\nmeaningful diffs. “Meaningful” is a subjective concept and the\nalgorithm descriptions below are therefore fairly high-level with\nmany details left up to the implementation.","position":{"start":{"line":174,"column":1},"end":{"line":174,"column":1}},"key":"aBLooupZCl"}],"key":"xAmxXwNJ3Y"},{"type":"heading","depth":3,"position":{"start":{"line":182,"column":1},"end":{"line":182,"column":1}},"children":[{"type":"text","value":"Handling nested structures by alignment and recursion","position":{"start":{"line":182,"column":1},"end":{"line":182,"column":1}},"key":"Euj8HRJlFI"}],"identifier":"handling-nested-structures-by-alignment-and-recursion","label":"Handling nested structures by alignment and recursion","html_id":"handling-nested-structures-by-alignment-and-recursion","implicit":true,"key":"twiSZ9kRXv"},{"type":"paragraph","position":{"start":{"line":184,"column":1},"end":{"line":185,"column":1}},"children":[{"type":"text","value":"The diff of objects A and B is computed recursively, handling dicts\nand lists with different algorithms.","position":{"start":{"line":184,"column":1},"end":{"line":184,"column":1}},"key":"I6jVSzoPIN"}],"key":"c2YUl6ZktM"},{"type":"heading","depth":3,"position":{"start":{"line":188,"column":1},"end":{"line":188,"column":1}},"children":[{"type":"text","value":"Diff approach for dicts","position":{"start":{"line":188,"column":1},"end":{"line":188,"column":1}},"key":"Gjk6jYtRcb"}],"identifier":"diff-approach-for-dicts","label":"Diff approach for dicts","html_id":"diff-approach-for-dicts","implicit":true,"key":"XB5UbIA6Cd"},{"type":"paragraph","position":{"start":{"line":190,"column":1},"end":{"line":196,"column":1}},"children":[{"type":"text","value":"When computing the diff of two dicts, items are always aligned by key\nvalue, i.e. under no circumstances are values under different keys\ncompared or diffed. This makes both diff and merge quite\nstraightforward. Modified leaf values that are both a list or both a\ndict will be diffed recursively, with the diff object recording a\n“patch” operation.  Any other modified leaf values are considered\nreplaced.","position":{"start":{"line":190,"column":1},"end":{"line":190,"column":1}},"key":"USADM2sOyK"}],"key":"aroWLh4S4V"},{"type":"heading","depth":3,"position":{"start":{"line":199,"column":1},"end":{"line":199,"column":1}},"children":[{"type":"text","value":"Diff approach for lists","position":{"start":{"line":199,"column":1},"end":{"line":199,"column":1}},"key":"qorCSRPJor"}],"identifier":"diff-approach-for-lists","label":"Diff approach for lists","html_id":"diff-approach-for-lists","implicit":true,"key":"DNE0ZBcJMb"},{"type":"paragraph","position":{"start":{"line":201,"column":1},"end":{"line":206,"column":1}},"children":[{"type":"text","value":"We wish to diff sequences and also recurse and diff aligned elements\nwithin the sequences. The core approach is to first align elements,\nrequiring some heuristic for comparing elements, and then recursively\ndiff the elements that are determined equal. ","position":{"start":{"line":201,"column":1},"end":{"line":201,"column":1}},"key":"AnfGoCltVR"},{"type":"emphasis","position":{"start":{"line":201,"column":1},"end":{"line":201,"column":1}},"children":[{"type":"text","value":"These heuristics will\ncontain the bulk of the notebook-specific diff algorithm\ncustomizations.","position":{"start":{"line":201,"column":1},"end":{"line":201,"column":1}},"key":"Z7ABpLkuN4"}],"key":"MTlU8CNoEA"}],"key":"wqRFIbxJw0"},{"type":"paragraph","position":{"start":{"line":208,"column":1},"end":{"line":215,"column":1}},"children":[{"type":"text","value":"The most used approach for computing linebased diffs of source code is\nto solve the longest common subsequence (lcs) problem or some\nvariation of it. We extend the vanilla LCS problem by allowing\ncustomizable predicates for approximate equality of two items,\nallowing e.g. a source cell predicate to determine that two pieces of\nsource code are approximately equal and should be considered the same\ncell, or an output cell predicate to determine that two bitmap images\nare almost equal.","position":{"start":{"line":208,"column":1},"end":{"line":208,"column":1}},"key":"Fa13DzyeSH"}],"key":"aEtMe9x0Os"},{"type":"paragraph","position":{"start":{"line":217,"column":1},"end":{"line":224,"column":1}},"children":[{"type":"text","value":"In addition we have an experimental multilevel algorithm that employs\na basic LCS algorithm with a sequence of increasingly relaxed equality\npredicates, allowing e.g. prioritizing equality of source+output over\njust equality of source.  Note that determining good heuristics and\nrefining the above mentioned algorithms will be a significant part of\nthe work and some experimentation must be allowed. In particular the\nbehaviour of the multilevel approach must be investigated further and\nother approaches could be considered..","position":{"start":{"line":217,"column":1},"end":{"line":217,"column":1}},"key":"OQ37WxkWri"}],"key":"tVbhULlARv"},{"type":"heading","depth":3,"position":{"start":{"line":227,"column":1},"end":{"line":227,"column":1}},"children":[{"type":"text","value":"Displaying metadata diffs","position":{"start":{"line":227,"column":1},"end":{"line":227,"column":1}},"key":"O271ivpkAp"}],"identifier":"displaying-metadata-diffs","label":"Displaying metadata diffs","html_id":"displaying-metadata-diffs","implicit":true,"key":"Zx3SY66IzY"},{"type":"paragraph","position":{"start":{"line":229,"column":1},"end":{"line":237,"column":1}},"children":[{"type":"text","value":"The notebook format has metadata in various locations,\nincluding on each cell, output, and top-level on the notebook.\nThese are dictionaries with potentially arbitrary JSON content.\nComputing metadata diffs is not different from any other dictionary diff.\nHowever, metadata generally does not have a visual representation in the live notebook,\nbut it must be indicated in the diff view if there are changes.\nWe will explore various represenentations of metadata changes in the notebook view.\nThe most primitive would be to display the raw dictionary diff as a JSON field in the notebook view,\nnear the displayable item the metadata is associated with.","position":{"start":{"line":229,"column":1},"end":{"line":229,"column":1}},"key":"zc5X1Z1qrQ"}],"key":"pYxK4h11Od"},{"type":"heading","depth":3,"position":{"start":{"line":240,"column":1},"end":{"line":240,"column":1}},"children":[{"type":"text","value":"Note about the potential addition of a “move” transformation","position":{"start":{"line":240,"column":1},"end":{"line":240,"column":1}},"key":"G26BhdCfsQ"}],"identifier":"note-about-the-potential-addition-of-a-move-transformation","label":"Note about the potential addition of a “move” transformation","html_id":"note-about-the-potential-addition-of-a-move-transformation","implicit":true,"key":"WHlMGeEUjQ"},{"type":"paragraph","position":{"start":{"line":242,"column":1},"end":{"line":244,"column":1}},"children":[{"type":"text","value":"In the current implementation there is no “move” operation.\nFurthermore we make some assumptions on the structure of the json\nobjects and what kind of transformations are meaningful in a diff.","position":{"start":{"line":242,"column":1},"end":{"line":242,"column":1}},"key":"k5bj6WeXyB"}],"key":"baGZsyP7sY"},{"type":"paragraph","position":{"start":{"line":246,"column":1},"end":{"line":250,"column":1}},"children":[{"type":"text","value":"Items swapping position in a list will be considered added and removed\ninstead of moved, but in a future iteration adding a “move” operation\nis an option to be considered. The main use case for this would be to\nresolve merges without conflicts when cells in a notebook are\nreordered on one side and modified on the other side.","position":{"start":{"line":246,"column":1},"end":{"line":246,"column":1}},"key":"ndIZe8aOVF"}],"key":"xZhNMpNiWw"},{"type":"paragraph","position":{"start":{"line":252,"column":1},"end":{"line":253,"column":1}},"children":[{"type":"text","value":"Even if we add the move operation, values will never be moved between\nkeys in a dict, e.g.:","position":{"start":{"line":252,"column":1},"end":{"line":252,"column":1}},"key":"aB4hXy1inf"}],"key":"JMWLeXMxPk"},{"type":"code","lang":"","value":"diff({\"a\":\"x\", \"b\":\"y\"}, {\"a\":\"y\", \"b\":\"x\"})","position":{"start":{"line":255,"column":1},"end":{"line":255,"column":1}},"key":"SGzb5rod5v"},{"type":"paragraph","position":{"start":{"line":257,"column":1},"end":{"line":257,"column":1}},"children":[{"type":"text","value":"will be:","position":{"start":{"line":257,"column":1},"end":{"line":257,"column":1}},"key":"Ddo2aFBFOE"}],"key":"BCNACnNcJZ"},{"type":"code","lang":"","value":"[{\"op\": \"replace\", \"key\": \"a\", \"value\": \"y\"},\n {\"op\": \"replace\", \"key\": \"b\", \"value\": \"x\"}]","position":{"start":{"line":259,"column":1},"end":{"line":260,"column":1}},"key":"XL5a2hTNFz"},{"type":"paragraph","position":{"start":{"line":262,"column":1},"end":{"line":263,"column":1}},"children":[{"type":"text","value":"In a notebook context this means for example that data will never be\nconsidered to move across input cells and output cells.","position":{"start":{"line":262,"column":1},"end":{"line":262,"column":1}},"key":"F25Di52XRo"}],"key":"vfFZNtXMHu"},{"type":"heading","depth":2,"position":{"start":{"line":266,"column":1},"end":{"line":266,"column":1}},"children":[{"type":"text","value":"Merge format","position":{"start":{"line":266,"column":1},"end":{"line":266,"column":1}},"key":"aqd0UDAJ1f"}],"identifier":"merge-format","label":"Merge format","html_id":"merge-format","implicit":true,"key":"JKoN22TW9C"},{"type":"paragraph","position":{"start":{"line":268,"column":1},"end":{"line":274,"column":1}},"children":[{"type":"text","value":"A merge takes as input a base object (notebook) and local and remote\nobjects (notebooks) that are modified versions of base. The merge\ncomputes the diffs base->local and base->remote and tries to apply all\nchanges from each diff to base. The merge returns a merged object\n(notebook) contains all successfully applied changes from both sides,\nand two diff objects merged->loc